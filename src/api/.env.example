# Example API configuration (dummy local values; never commit real secrets).
DATABASE_URL=postgres://tableflow_app:app_dev_only@127.0.0.1:54318/tableflow?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
DB_MAX_CONNS=10
READINESS_TIMEOUT=1s
SHUTDOWN_TIMEOUT=10s
DB_STATEMENT_TIMEOUT=5s
DB_LOCK_TIMEOUT=2s
DB_IDLE_IN_TRANSACTION_TIMEOUT=10s
# Release-step migrations use the owner role, not the API role.
MIGRATION_DATABASE_URL=postgres://tableflow_owner:owner_dev_only@127.0.0.1:54318/tableflow?sslmode=disable
# Staff identity
ADMIN_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
STAFF_SESSION_IDLE=60m
STAFF_SESSION_ABSOLUTE=12h
# Only a reverse proxy that appends/overwrites X-Forwarded-For. Empty = trust none.
TRUSTED_PROXY_CIDRS=
# Customer origins allowed to send guest/anonymous/member mutations.
PWA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Base64 of 32 random bytes (e.g. `openssl rand -base64 32`). Required. Dummy value below.
DATA_ENCRYPTION_KEY=dGFibGVmbG93LWxvY2FsLWRldi1vbmx5LWtleS0zMmI=
# Mail (ADR-0005): Resend over SMTP with TLS required, locally and in
# production. Plaintext is not supported. Without credentials the API starts,
# logs "mail delivery not configured" and every send fails.
SMTP_ADDR=smtp.resend.com:587
SMTP_TLS=starttls
SMTP_USERNAME=resend
# The Resend API key: set it in your shell or secret store, never in a file
# that is committed.
SMTP_PASSWORD=
# MAIL_ADAPTER=file with MAIL_OUTBOX_DIR is for automated tests only.
MAIL_ADAPTER=smtp
# Must be an address on the Resend-verified sending domain (pending).
MAIL_FROM=TableFlow <no-reply@example.invalid>
# Public PWA origin used in emailed links.
PWA_PUBLIC_URL=http://localhost:3000
