# Copy to staging.env (git-ignored) and fill in. Never commit real values.
ADMIN_HOST=admin.tableflow.localhost
PWA_HOST=pwa.tableflow.localhost
# "internal" = Caddy's local CA for a local rehearsal; empty = public ACME certificates.
CADDY_TLS=internal
POSTGRES_PASSWORD=
TABLEFLOW_OWNER_PASSWORD=
TABLEFLOW_APP_PASSWORD=
# 32 random bytes, base64 (openssl rand -base64 32). Losing it makes stored
# idempotency replays unreadable; they expire within days (no data loss).
DATA_ENCRYPTION_KEY=
# Resend SMTP (ADR-0005): set both together — SMTP_USERNAME=resend and the API
# key as SMTP_PASSWORD. Left empty, the API starts but logs that delivery is
# not configured and every send fails (no plaintext fallback).
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=TableFlow <no-reply@example.invalid>
